# PizzaHub client environment variables.
# Copy this file to `.env.local` (git-ignored) and fill in the values.

# Base URL of the PizzaHub backend API (PORT from pizzahub-server/.env).
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api

# Canonical public URL of this app (used for metadata and absolute links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Better Auth (server-only; never prefix these with NEXT_PUBLIC_) ──
# Signs session cookies and encrypts the stored JWT signing keys.
# Generate a value with: npx @better-auth/cli secret
BETTER_AUTH_SECRET=

# Canonical origin Better Auth uses to build the JWT `iss`/`aud` claims.
# Must exactly match JWT_ISSUER/JWT_AUDIENCE below (no trailing slash).
BETTER_AUTH_URL=http://localhost:3000

# Same MongoDB database as pizzahub-server — Better Auth owns the shared
# `users` collection and the Express API reads it on every protected request.
MONGODB_URI=mongodb://localhost:27017
DB_NAME=pizzahub

# Must exactly match JWT_ISSUER / JWT_AUDIENCE in pizzahub-server/.env.
JWT_ISSUER=http://localhost:3000
JWT_AUDIENCE=http://localhost:3000

# Google OAuth (server-only; used by Better Auth's Google social provider).
# Authorized redirect URI for local dev:
#   http://localhost:3000/api/auth/callback/google
# Set GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET from Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
