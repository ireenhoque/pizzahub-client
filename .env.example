# PizzaHub client environment variables.
# Copy this file to `.env.local` (git-ignored) and fill in the values.

# Base URL of the PizzaHub backend API.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# Canonical public URL of this app (used for metadata and absolute links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
